{
  "name": "av0-portfolio",
  "version": "3.0.0",
  "private": true,
  "description": "The personal software development portfolio of av0.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:subpath": "node scripts/serve-dist-subpath.mjs",
    "typecheck": "tsc -b --pretty false",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "check": "npm run typecheck && npm run audit:contrast && npm run build"
  },
  "keywords": [
    "portfolio",
    "software-developer",
    "full-stack",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/doto": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
